@@ -82,7 +85,10 @@ void PasswdMgr::restrictFilesPermission(void)
     {
         if ((st.st_mode & modeMask) != (S_IRUSR | S_IWUSR))
         {
-            chmod(encryptKeyFileName, S_IRUSR | S_IWUSR);
